{
  "WelcomeString"   : "Hello... Robot Framework is running now!",

  "Maximum_version" : "1.0.0",
  "Minimum_version" : "0.6.0",

  "Project"         : "tsm-test_config_python_inline_code",
  "TargetName"      : "Device_01",

  "params" : {
              "global" : {
                            // JSONP content taken over from: https://github.com/test-fullautomation/python-jsonpreprocessor/tree/develop/test/testfiles
                            //
                            "A"       : 1,
                            "B"       : 2,
                            "kA"      : "kA",
                            "kB"      : "kB",
                            "choice"  : True,

                            "value01" : <<"ABC">>,
                            "value02" : <<25>>,
                            "value03" : <<2.5>>,
                            "value04" : <<True>>,
                            "value05" : <<None>>,

                            "value06" : <<[1, 2]>>,
                            "value07" : <<{"kA" : 1, "kB" : 2}>>,

                            "expression1" : [1, 2],
                            "value08"     : <<${params.global.expression1}>>,

                            "expression2" : {"kA" : 1, "kB" : 2},
                            "value09"     : <<${params.global.expression2}>>,

                            "value10" : <<1 if True else 2>>,
                            "value11" : <<${params.global.A} if ${params.global.choice} else ${params.global.B}>>,

                            // expression not resolved // "value12" : ["A", <<${params.global.A} if ${params.global.choice} else ${params.global.B}>>, "Z"],

                            "value13" : {"kA" : "A",
                                        "kB" : <<${params.global.A} if ${params.global.choice} else ${params.global.B}>>,
                                        "kC" : "C"},

                            // "listval"       : [1,2,3],
                            // "dictval"       : {"kA" : "vA", "kB" : "vB"},
                            // error // "value14" : ${params.global.listval}[<<${params.global.A} if ${params.global.choice} else ${params.global.B}>>],
                            // error // "value15" : ${params.global.dictval}[<<${params.global.kA} if ${params.global.choice} else ${params.global.kB}>>]

                            "list1"   : [1,2,3],
                            "list2"   : [4,5,6],
                            "value16" : <<${params.global.list1} + [${params.global.list2} + ${params.global.list1}]>>,

                            "dict"    : {"kA" : "vA", "kB" : "vB"},
                            "value17" : <<list(${params.global.dict}.keys())>>

                            // error // "value18" : <<(${params.global.list1}[0] if ${params.global.choice} else ${params.global.list2.1}) + 1>>,
                            // error // "code1"   : "(${params.global.list1}[0] if ${params.global.choice} else ${params.global.list2.1}) + 1",
                            // error // "value19" : <<(${code1}) + 4>>,
                       }
            }
}

